# Modèle du fichier .env : le copier en .env (jamais publié) puis remplacer les valeurs.

# Clé secrète de Django : en générer une avec
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True en développement uniquement
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL : le mot de passe doit être rempli avant le premier démarrage.
POSTGRES_DB=cocagne
POSTGRES_USER=cocagne
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# En local, Caddy utilise HTTP sur ce port.
HTTP_PORT=8000
# Adresse utilisée par Caddy avec compose.yaml seul (HTTPS automatique).
SITE_ADDRESS=localhost

# Compte d'administration imposé (admin / sae5), créé par `python manage.py createsuperuser --noinput`
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com
